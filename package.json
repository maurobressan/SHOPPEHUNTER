{
    "name": "shopee-hunter-pro",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3000",
        "build": "next build",
        "start": "next start -p 3000",
        "test": "vitest run",
        "db:push": "prisma db push",
        "db:seed": "tsx prisma/seed.ts",
        "coletar": "tsx scripts/coletar.ts",
        "setup": "prisma db push && tsx prisma/seed.ts",
        "db:pg:sync": "node scripts/pg-schema.mjs",
    "ext:pack": "node scripts/pack-extension.mjs",
        "vercel-build": "prisma generate --schema prisma/postgres/schema.prisma && prisma migrate deploy --schema prisma/postgres/schema.prisma && tsx prisma/seed.ts && next build"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "1.3.0",
        "@prisma/client": "6.10.1",
        "exceljs": "4.4.0",
        "lucide-react": "0.511.0",
        "next": "15.5.28",
        "papaparse": "5.5.3",
        "react": "19.1.10",
        "react-dom": "19.1.10",
        "recharts": "2.15.3",
        "stripe": "23.0.1",
        "zod": "3.25.67"
    },
    "devDependencies": {
        "@types/node": "22.15.30",
        "@types/papaparse": "5.3.16",
        "@types/react": "19.1.8",
        "@types/react-dom": "19.1.6",
        "autoprefixer": "10.4.21",
        "postcss": "8.5.6",
        "prisma": "6.10.1",
        "tailwindcss": "3.4.17",
        "tsx": "4.20.3",
        "typescript": "5.8.3",
        "vitest": "3.2.4"
    }
