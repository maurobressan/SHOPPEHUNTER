# Copie para ".env" e preencha só o que for usar. NUNCA publique o arquivo .env.

# ---------- Essencial ----------
DATABASE_URL="file:./dev.db"          # produção: postgresql://usuario:senha@host:5432/banco (veja DEPLOY.md)
APP_URL="http://localhost:3000"       # produção: https://seudominio.com.br
TRIAL_DAYS="7"                        # dias de teste grátis do plano Pro para contas novas (0 = sem teste)

# Dados exibidos nos Termos de Uso e na Política de Privacidade
COMPANY_NAME=""
COMPANY_DOC=""
SUPPORT_EMAIL=""

# ---------- Coleta automática: Shopee Afiliados (oficial, gratuita, exige conta aprovada) ----------
# https://affiliate.shopee.com.br -> Open API -> AppID e Secret
SHOPEE_AFFILIATE_APP_ID=""
SHOPEE_AFFILIATE_SECRET=""
SHOPEE_AFFILIATE_ENDPOINT="https://open-api.affiliate.shopee.com.br/graphql"
CRON_SECRET=""                        # senha do agendador que chama /api/cron/coletar

# ---------- Pagamentos: Stripe ----------
STRIPE_SECRET_KEY=""                  # sk_test_... para testes; sk_live_... em produção
STRIPE_WEBHOOK_SECRET=""              # whsec_... (Stripe -> Webhooks -> {APP_URL}/api/billing/webhook)

# ---------- E-mail (recuperação de senha e convites): Resend ----------
RESEND_API_KEY=""
EMAIL_FROM=""                         # ex.: Shopee Hunter <nao-responda@seudominio.com.br>

# ---------- Assistente IA (opcional) ----------
# AI_PROVIDER: "anthropic" ou "openai" (qualquer API compatível: OpenAI, OpenRouter, Ollama local gratuito)
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL=""                        # ex. Ollama: http://localhost:11434/v1
