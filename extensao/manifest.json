{
  "manifest_version": 3,
  "name": "Shoppe Hunter — Salvar no Hunter",
  "version": "1.1.0",
  "description": "Mostra vendidos, tarifas e margem dos anúncios da Shopee que você está vendo e salva concorrentes no Shoppe Hunter.",
  "permissions": ["storage"],
  "host_permissions": ["https://shoppehunter.vercel.app/*", "http://localhost:3000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://shopee.com.br/*", "https://*.shopee.com.br/*"],
      "exclude_matches": ["https://seller.shopee.com.br/*"],
      "js": ["fees.js", "parse.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["icons/icon48.png"], "matches": ["https://shopee.com.br/*", "https://*.shopee.com.br/*"] }],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Shoppe Hunter", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } }
}
