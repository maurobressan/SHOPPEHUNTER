{
  "manifest_version": 3,
  "name": "Shopee Hunter Pro — Salvar no Hunter",
  "version": "1.0.0",
  "description": "Mostra tarifas e margem do anúncio da Shopee que você está vendo e salva concorrentes no Shopee Hunter Pro.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://shopee.com.br/*", "https://*.shopee.com.br/*"],
      "js": ["fees.js", "parse.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Shopee Hunter Pro" }
}
