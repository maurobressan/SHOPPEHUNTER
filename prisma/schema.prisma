// Banco multi-conta (SaaS). Local: SQLite. Produção: troque o provider para "postgresql"
// e DATABASE_URL para a URL do Postgres (ver DEPLOY.md). Todos os dados de clientes têm accountId.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------- Contas, usuários e acesso ----------------

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  isAdmin      Boolean      @default(false) // administrador da plataforma (você)
  createdAt    DateTime     @default(now())
  lastLoginAt  DateTime?
  memberships  Membership[]
  sessions     Session[]
  resets       PasswordReset[]
}

model Account {
  id           String          @id @default(cuid())
  name         String
  createdAt    DateTime        @default(now())
  memberships  Membership[]
  subscription Subscription?
  settings     AccountSetting?
  tokens       ApiToken[]
  invites      Invite[]
  products     Product[]
  listings     Listing[]
  suppliers    Supplier[]
  batches      ImportBatch[]
  orderLines   OrderLine[]
  skuCosts     SkuCost[]
  skuStocks    SkuStock[]
  runs         CollectionRun[]
  alerts       Notification[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      String // owner | admin | member
  createdAt DateTime @default(now())

  @@unique([userId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String // conta ativa nesta sessão
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String   @default("")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

model Invite {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email      String
  role       String    @default("member")
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Token para a extensão do navegador e integrações (guardamos só o hash).
model ApiToken {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ---------------- Planos e assinaturas ----------------

model Plan {
  id            String         @id // slug: gratis | pro | business
  name          String
  description   String         @default("")
  priceCents    Int // preço mensal em centavos (BRL)
  limits        String // JSON: PlanLimits
  stripePriceId String?
  active        Boolean        @default(true)
  highlighted   Boolean        @default(false)
  sort          Int            @default(0)
  subscriptions Subscription[]
}

model Subscription {
  id                     String    @id @default(cuid())
  accountId              String    @unique
  account                Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan      @relation(fields: [planId], references: [id])
  status                 String // trialing | active | past_due | canceled
  provider               String    @default("manual") // manual | stripe
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  updatedAt              DateTime  @updatedAt
}

// ---------------- Configurações ----------------

model AccountSetting {
  accountId String  @id
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  value     String // JSON: AppSettings
}

// Tabela de comissão versionada (global, mantida pelo administrador da plataforma).
model FeeSchedule {
  id          String    @id @default(cuid())
  name        String
  sellerType  String // "CNPJ" | "CPF"
  validFrom   DateTime
  validTo     DateTime?
  sourceUrl   String
  sourceTitle String
  notes       String    @default("")
  rules       String // JSON: FeeRules
  createdAt   DateTime  @default(now())
}

// ---------------- Dados do cliente ----------------

model Product {
  id            String          @id @default(cuid())
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  keywords      String          @default("")
  category      String          @default("")
  status        String          @default("monitorando") // monitorando | testando | vendendo | descartado
  notes         String          @default("")
  targetPrice   Float?
  chosenQuoteId String?
  isDemo        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  listings      Listing[]
  quotes        SupplierQuote[]
  reports       AiReport[]
  alerts        Notification[]

  @@index([accountId])
}

model Listing {
  id              String     @id @default(cuid())
  accountId       String
  account         Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  externalItemId  String?
  shopId          String?
  shopName        String     @default("")
  title           String
  url             String     @default("")
  imageUrl        String     @default("")
  categoryIds     String     @default("")
  weakPhotos      Boolean    @default(false)
  weakDescription Boolean    @default(false)
  isDemo          Boolean    @default(false)
  firstSeenAt     DateTime   @default(now())
  snapshots       Snapshot[]

  @@unique([accountId, externalItemId, shopId])
  @@index([accountId])
}

model Snapshot {
  id              String   @id @default(cuid())
  listingId       String
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  source          String // shopee_affiliate_api | extensao | manual | demo
  collectedAt     DateTime @default(now())
  referenceDate   DateTime
  price           Float?
  priceMin        Float?
  priceMax        Float?
  salesCumulative Int? // vendas acumuladas informadas pela fonte (NUNCA tratar como vendas do período)
  ratingStar      Float?
  ratingCount     Int?
  reliability     String // alta | media | baixa
  raw             String   @default("")

  @@unique([listingId, source, collectedAt])
  @@index([listingId, referenceDate])
}

model Supplier {
  id        String          @id @default(cuid())
  accountId String
  account   Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  kind      String
  country   String          @default("Brasil")
  location  String          @default("")
  website   String          @default("")
  contact   String          @default("")
  notes     String          @default("")
  isDemo    Boolean         @default(false)
  createdAt DateTime        @default(now())
  quotes    SupplierQuote[]

  @@index([accountId])
}

model SupplierQuote {
  id           String   @id @default(cuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice    Float?
  moq          Int?
  tiers        String   @default("")
  shippingCost Float?
  leadTimeDays Int?
  availability String   @default("")
  channel      String
  productUrl   String   @default("")
  quoteDate    DateTime @default(now())
  notes        String   @default("")
  isDemo       Boolean  @default(false)
}

model ImportBatch {
  id         String      @id @default(cuid())
  accountId  String
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filename   String
  importedAt DateTime    @default(now())
  totalRows  Int
  accepted   Int
  duplicates Int
  rejected   Int
  mapping    String
  errors     String      @default("")
  lines      OrderLine[]
}

model OrderLine {
  id             String      @id @default(cuid())
  accountId      String
  account        Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  batchId        String
  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  dedupeKey      String
  orderId        String
  orderDate      DateTime
  status         String
  rawStatus      String
  sku            String
  productName    String
  variation      String      @default("")
  quantity       Int
  unitPrice      Float
  grossAmount    Float
  sellerDiscount Float       @default(0)
  shopeeDiscount Float       @default(0)
  commissionFee  Float?
  serviceFee     Float?
  transactionFee Float?
  refundAmount   Float       @default(0)

  @@unique([accountId, dedupeKey])
}

model SkuCost {
  accountId     String
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sku           String
  unitCost      Float
  packagingCost Float   @default(0)

  @@id([accountId, sku])
}

// Estoque informado pelo vendedor (contagem em countedAt) e prazo do fornecedor, para a reposição.
model SkuStock {
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sku          String
  quantity     Int
  leadTimeDays Int      @default(15)
  countedAt    DateTime @default(now())

  @@id([accountId, sku])
}

model AiReport {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  engine    String
  model     String   @default("")
  content   String
  inputs    String
}

model CollectionRun {
  id         String    @id @default(cuid())
  accountId  String?
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String
  message    String    @default("")
  items      Int       @default(0)
}

model Notification {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      String // preco | concorrente | tendencia | margem | sistema
  title     String
  body      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, readAt])
}
